# Large binaries: tracked by M6_BASELINE.sha256, not by Git
engine/models/
tests/clips/
projects/*/build/
# Generated or local
exports/*
!exports/.keep
tests/out/
__pycache__/
*.pyc
.DS_Store
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
*.sqlite3
*.db
*.log
.coverage
.pytest_cache/
.mypy_cache/
.vite/
app/web/node_modules/
app/web/dist/
.heavy_model.lock
engine/.heavy_model.lock
*.render.lock
.claude/settings.local.json

# M5 runtime data (sessions, Brand Library) belongs to this machine, not to Git
m5/.runtime/

# Isolated engine job roots (renders, copies of projects)
jobs/
.heavy_model.lock
